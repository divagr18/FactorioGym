{
  "id": "advance_success",
  "protocol": 1,
  "description": "Exact stepping: request N ticks, get running then settled completed.",
  "request": {
    "protocol": 1,
    "request_id": "<auto>",
    "episode_id": "<current>",
    "type": "advance",
    "payload": {"ticks": 30}
  },
  "response": {
    "protocol": 1,
    "code": "ok",
    "result": {"status": "running", "target_ticks": 30}
  },
  "settled": {
    "protocol": 1,
    "code": "ok",
    "result": {"status": "completed", "ticks_advanced": 30}
  }
}
