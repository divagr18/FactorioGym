  "gate": "R2.1 conformance",
  "catalog": "parameterized-v1",
  "note": "Every action goes through env.step_arguments, which validates each argument against an observation-derived domain and then calls the same step_payload the discrete policy path uses. No reference solver, no direct session.step, no RCON, no evaluator truth.",
  "checks": [
    {
      "check": "scene publishes a work site",
      "ok": true,
      "gap": [
        9.5,
        -7.5
      ]
    },
    {
      "check": "target identity survives movement",
      "ok": true,
      "before": 12,
      "after": 12,
      "stable": 12
    },
    {
      "check": "placed at a chosen tile with a chosen facing",
      "ok": true,
      "wanted_facing": 4,
      "got": 4,
      "outcome": {
        "status": "completed",
        "error": null
      }
    },
    {
      "check": "occupied tile -> refused by the domain, with a name",
      "ok": true,
      "outcome": {
        "status": "client_refused",
        "error": "place_at: position=[9.5, -7.5] is not in domain 'placements' (111 values)"
      }
    },
    {
      "check": "occupied tile -> engine reports collision",
      "ok": true,
      "error": "collision"
    },
    {
      "check": "stale handle -> refused with a name",
      "ok": true,
      "outcome": {
        "status": "client_refused",
        "error": "rotate_at: handle='h999999' is not in domain 'targets' (13 values)"
      }
    },
    {
      "check": "empty inventory -> refused by the domain, with a name",
      "ok": true,
      "outcome": {
        "status": "client_refused",
        "error": "place_at: item='transport-belt' is not in domain 'items' (0 values)"
      }
    },
    {
      "check": "empty inventory -> engine reports no_items",
      "ok": true,
      "error": "no_items"
    },
    {
      "check": "chain scene exposes a machine",
      "ok": true,
      "name": "burner-mining-drill"
    },
    {
      "check": "transfer to a named handle with an explicit count",
      "ok": true,
      "outcome": {
        "status": "completed",
        "error": null
      }
    },
    {
      "check": "the transfer's declared effect was observed",
      "ok": true,
      "states": [
        "confirmed"
      ]
    },
    {
      "check": "machine reports working explicitly, not by an absent field",
      "ok": true,
      "states": [
        [
          "working",
          true
        ]
      ]
    },
    {
      "check": "machine status carries a readable name",
      "ok": true,
      "names": [
        "working"
      ]
    },
    {
      "check": "fuel contents are observable",
      "ok": true,
      "fuel": [
        {
          "coal": 19
        }
      ]
    },
    {
      "check": "the craftable set is observable",
      "ok": true,
      "count": 22,
      "sample": [
        "burner-inserter",
        "burner-mining-drill",
        "copper-plate",
        "firearm-magazine",
        "iron-chest"
      ]
    }
